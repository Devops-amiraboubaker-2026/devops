# MongoDB connection URI
MONGO_URI=mongodb://root:pass-123@mongodb:27017/book-store?authSource=admin
# Port to run the backend API
PORT=3001
# Root username for MongoDB
MONGO_INITDB_ROOT_USERNAME=root
# Root password for MongoDB
MONGO_INITDB_ROOT_PASSWORD=pass-123
# Initial database to create
MONGO_INITDB_DATABASE=book-store
# MongoDB URL for mongo-express
ME_CONFIG_MONGODB_URL=mongodb://root:pass-123@mongodb:27017/book-store?authSource=admin
ME_CONFIG_BASICAUTH_ENABLED=true
ME_CONFIG_BASICAUTH_USERNAME=user
ME_CONFIG_BASICAUTH_PASSWORD=password
